HOST=127.0.0.1
PORT=4173
DATA_DIR=data
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
SERVICE_VERSION=development
PUBLIC_BASE_URL=
REQUEST_BODY_LIMIT_BYTES=1048576
SECURITY_HEADERS_ENABLED=true

# Production-only credentials used when creating the first super administrator.
# No production password is provided by default.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Production security secrets. Use independent random values and never commit them.
CSRF_SECRET=
SECURITY_HASH_SECRET=
PAYMENT_WEBHOOK_SECRET=
ALLOWED_ORIGINS=http://127.0.0.1:4173
TRUST_PROXY=false
GENERAL_RATE_LIMIT=120
AUDIT_RETENTION_DAYS=180

# Production SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional non-production error reporting. Leave empty to use local logs only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Database backup and optional S3-compatible storage.
BACKUP_DIR=backups
BACKUP_LOCAL_RETENTION_DAYS=7
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
